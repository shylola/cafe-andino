<%- include('partials/header') %>
<h1>Crear cuenta</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/registro" class="formulario">
  <label>Nombre <input name="nombre" value="<%= datos.nombre || '' %>" required></label>
  <label>Email <input name="email" type="email" value="<%= datos.email || '' %>" required></label>
  <label>Clave (mínimo 6 caracteres) <input name="password" type="password" minlength="6" required></label>
  <button class="boton">Crear cuenta</button>
</form>
<%- include('partials/footer') %>
