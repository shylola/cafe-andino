<%- include('partials/header') %>
<div class="contenedor caja-form">
  <h1>Iniciar sesión</h1>
  <% if (error) { %><p class="error"><%= error %></p><% } %>
  <form method="post" action="/login" class="formulario">
    <label>Email <input name="email" type="email" value="<%= email %>" autocomplete="email" required></label>
    <label>Clave <input name="password" type="password" autocomplete="current-password" required></label>
    <button class="btn ancho" data-cargando="Ingresando…">Ingresar</button>
  </form>
  <p class="centro">¿No tienes cuenta? <a href="/registro">Crea una</a></p>
</div>
<%- include('partials/footer') %>
