<article class="tarjeta">
  <a href="/producto/<%= p.slug %>">
    <img src="/img/<%= p.categoria.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z]+/g,'-') %>.svg" alt="" width="240" height="160" loading="lazy">
    <h3><%= p.nombre %></h3>
  </a>
  <p class="cat"><%= p.categoria %><% if (p.origen) { %> · <%= p.origen %><% } %></p>
  <p class="precio"><%= clp(p.precio) %></p>
  <form action="/carrito/agregar" method="post">
    <input type="hidden" name="id" value="<%= p.id %>">
    <input type="hidden" name="volver" value="<%= typeof volver !== 'undefined' ? volver : '/carrito' %>">
    <button>Agregar al carrito</button>
  </form>
</article>
