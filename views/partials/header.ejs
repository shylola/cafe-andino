<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= titulo %> · <%= tienda %></title>
  <meta name="description" content="Café de especialidad de altura, té, accesorios y repostería. Tostado en Santiago, despacho a todo Chile.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500&display=swap" rel="stylesheet">
  <meta name="theme-color" content="#392116">
  <script>document.documentElement.classList.add('js');</script>
  <link rel="stylesheet" href="/css/estilos.css?v=<%= cssVersion %>">
  <% if (gaId) { %>
  <!-- Google Analytics 4 (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= gaId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= gaId %>'<% if (usuario) { %>, { user_id: '<%= usuario.id %>' }<% } %>);
  </script>
  <% } else { %>
  <script>window.gtag = function(){ (window.gaDebug = window.gaDebug || []).push(arguments); };</script>
  <% } %>
</head>
<body>
<a class="saltar" href="#contenido">Ir al contenido</a>
<div class="anuncio" aria-live="polite">
  <p class="anuncio-item activo">Despacho gratis en compras sobre $39.990 · Retiro gratis en tienda</p>
  <p class="anuncio-item">Tostamos cada martes: tu café llega fresco</p>
  <p class="anuncio-item">Paga seguro con Webpay · Débito, crédito y prepago</p>
</div>
<header class="cabecera">
  <div class="cabecera-in">
    <details class="menu-movil">
      <summary aria-label="Menú">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </summary>
      <nav class="menu-movil-panel">
        <form action="/productos" method="get" role="search"><input name="q" type="search" placeholder="Buscar productos" aria-label="Buscar productos" class="buscar-movil"></form>
        <a href="/productos">Todo</a>
        <% categoriasMenu.forEach(c => { %><a href="/productos?categoria=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %>
        <% if (usuario) { %><a href="/mis-compras">Mis compras</a><% } else { %><a href="/login">Iniciar sesión</a><% } %>
      </nav>
    </details>
    <a class="logo" href="/" aria-label="<%= tienda %>, inicio">
      <svg width="38" height="26" viewBox="0 0 38 26" aria-hidden="true"><path d="M1 25 L12 7 L19 16 L25 9 L37 25 Z" fill="currentColor"/><path d="M12 7 L15.5 12.5 L12 11 L8.6 12.6 Z" fill="var(--crema)"/><circle cx="29" cy="5" r="3.5" fill="var(--terracota)"/></svg>
      <span class="logo-texto"><span class="logo-nombre"><%= tienda %></span><span class="logo-lema">Café de altura</span></span>
    </a>
    <nav class="menu" aria-label="Principal">
      <% categoriasMenu.forEach(c => { %>
        <a href="/productos?categoria=<%= encodeURIComponent(c) %>"><%= c %></a>
      <% }) %>
    </nav>
    <div class="utilidades">
      <form class="buscar" action="/productos" method="get" role="search">
        <input name="q" type="search" placeholder="Buscar" aria-label="Buscar productos">
        <button aria-label="Buscar" class="icono"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg></button>
      </form>
      <% if (usuario) { %>
        <a class="icono" href="/mis-compras" title="Mis compras (<%= usuario.nombre %>)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></a>
        <form action="/logout" method="post" class="inline"><button class="enlace-salir">Salir</button></form>
      <% } else { %>
        <a class="icono" href="/login" title="Iniciar sesión"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></a>
      <% } %>
      <a class="icono carrito<%= flash && cantCarrito ? ' rebote' : '' %>" href="/carrito" title="Carrito">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 7h14l-1.5 13h-11z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
        <span class="burbuja" aria-label="Carrito (<%= cantCarrito %>)"<%= cantCarrito ? '' : ' data-cero' %>><%= cantCarrito %></span>
      </a>
    </div>
  </div>
</header>
<% if (flash) { %><div class="flash" role="status"><span><%= flash %></span><% if (cantCarrito) { %><a href="/carrito">Ver carrito</a><% } %></div><% } %>
<main id="contenido">
