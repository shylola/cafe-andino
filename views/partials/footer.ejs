</main>
<section class="beneficios" data-revelar>
  <div><strong>Tostado semanal</strong><span>Tostamos cada martes en Santiago.</span></div>
  <div><strong>Despacho a todo Chile</strong><span>Gratis sobre $39.990.</span></div>
  <div><strong>Pago seguro</strong><span>Webpay: débito, crédito y prepago.</span></div>
  <div><strong>Comercio directo</strong><span>Compramos a pequeños productores.</span></div>
</section>
<footer class="pie">
  <div class="pie-in">
    <div class="pie-marca">
      <p class="logo-pie"><%= tienda %></p>
      <p>Café de altura, del origen a tu taza.</p>
      <form class="newsletter" onsubmit="event.preventDefault(); gtag('event','generate_lead',{method:'newsletter'}); this.innerHTML='<p>¡Listo! Te escribiremos pronto.</p>';">
        <label for="nl">Suscríbete y recibe 10% en tu primera compra</label>
        <div><input id="nl" type="email" placeholder="tu@email.cl" required><button>Suscribirme</button></div>
      </form>
    </div>
    <div>
      <h4>Tienda</h4>
      <% categoriasMenu.forEach(c => { %><a href="/productos?categoria=<%= encodeURIComponent(c) %>"><%= c %></a><% }) %>
    </div>
    <div>
      <h4>Mi cuenta</h4>
      <a href="/login">Iniciar sesión</a><a href="/registro">Crear cuenta</a><a href="/mis-compras">Mis compras</a><a href="/carrito">Carrito</a>
    </div>
    <div>
      <h4>Información</h4>
      <span>Despachos de lunes a viernes</span><span>contacto@cafeandino.cl</span><span>Santiago, Chile</span>
    </div>
  </div>
  <p class="pie-legal">© 2026 <%= tienda %> · Proyecto académico Desempeño de Sistemas UTEM · Los pagos son de prueba (Transbank integración).</p>
</footer>
<script>
  // Barra de anuncios rotativa.
  (function () {
    var items = document.querySelectorAll('.anuncio-item'), i = 0;
    if (items.length > 1) setInterval(function () {
      items[i].classList.remove('activo'); i = (i + 1) % items.length; items[i].classList.add('activo');
    }, 4000);
  })();
  // Aparición suave de secciones al hacer scroll (se omite si el usuario prefiere menos movimiento).
  (function () {
    var els = document.querySelectorAll('[data-revelar]');
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
      els.forEach(function (e) { e.classList.add('visible'); }); return;
    }
    var io = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('visible'); io.unobserve(en.target); } });
    }, { rootMargin: '0px 0px -40px 0px' });
    els.forEach(function (e) { io.observe(e); });
  })();
  // Estado de carga en botones al enviar formularios (agregar al carrito, pagar, ingresar).
  document.addEventListener('submit', function (ev) {
    var b = ev.target.querySelector('[data-cargando]');
    if (b && !ev.defaultPrevented) { b.dataset.original = b.textContent; b.classList.add('cargando'); b.setAttribute('aria-busy', 'true'); b.textContent = b.dataset.cargando; }
  });
  // Al volver con el botón "atrás", restaurar los botones que quedaron en estado de carga.
  window.addEventListener('pageshow', function () {
    document.querySelectorAll('.cargando').forEach(function (b) {
      b.classList.remove('cargando'); b.removeAttribute('aria-busy'); if (b.dataset.original) b.textContent = b.dataset.original;
    });
  });
  // El aviso (flash) se oculta solo después de unos segundos.
  (function () {
    var f = document.querySelector('.flash');
    if (f) setTimeout(function () { f.classList.add('saliendo'); }, 4500);
  })();
  // Eventos GA4 de comercio electrónico generados por el servidor para esta página.
  <% if (gaPendiente) { %>gtag('event', <%- JSON.stringify(gaPendiente.evento) %>, <%- JSON.stringify(gaPendiente.params).replace(/</g, '\\u003c') %>);<% } %>
  <% if (ga) { %>gtag('event', <%- JSON.stringify(ga.evento) %>, <%- JSON.stringify(ga.params).replace(/</g, '\\u003c') %>);<% } %>
</script>
<script type="module">
  // Core Web Vitals (LCP, CLS, INP, FCP, TTFB) enviados a GA4 como eventos.
  import { onCLS, onINP, onLCP, onFCP, onTTFB } from 'https://unpkg.com/web-vitals@4.2.4/dist/web-vitals.js?module';
  const enviar = ({ name, delta, value, id, rating }) => gtag('event', name, {
    value: Math.round(name === 'CLS' ? delta * 1000 : delta),
    metric_id: id, metric_value: value, metric_rating: rating, non_interaction: true,
  });
  onCLS(enviar); onINP(enviar); onLCP(enviar); onFCP(enviar); onTTFB(enviar);
</script>
</body>
</html>
