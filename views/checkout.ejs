<%- include('partials/header') %>
<h1>Checkout</h1>
<p>Comprando como <strong><%= usuario.nombre %></strong> (<%= usuario.email %>).</p>
<ul class="resumen">
  <% items.forEach(i => { %><li><%= i.cantidad %> × <%= i.p.nombre %> — <%= clp(i.subtotal) %></li><% }) %>
</ul>
<p class="precio grande">Total: <%= clp(total) %></p>
<form action="/checkout" method="post" class="pago">
  <fieldset>
    <legend>Medio de pago</legend>
    <label><input type="radio" name="medio" value="webpay" checked> Webpay Plus (ambiente de integración Transbank)</label>
    <% if (simulado) { %><label><input type="radio" name="medio" value="simulado"> Pago simulado (para pruebas de carga)</label><% } %>
  </fieldset>
  <button class="boton">Pagar</button>
</form>
<details class="nota">
  <summary>Datos de prueba Webpay</summary>
  <p>Tarjeta VISA 4051 8856 0044 6623, CVV 123, cualquier fecha futura. En la autenticación: RUT 11.111.111-1, clave 123.</p>
</details>
<%- include('partials/footer') %>
