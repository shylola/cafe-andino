<%- include('partials/header') %>
<article class="detalle">
  <img src="/img/<%= p.categoria.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z]+/g,'-') %>.svg" alt="" width="480" height="320">
  <div>
    <p class="cat"><a href="/productos?categoria=<%= encodeURIComponent(p.categoria) %>"><%= p.categoria %></a></p>
    <h1><%= p.nombre %></h1>
    <p class="precio grande"><%= clp(p.precio) %></p>
    <p><%= p.descripcion %></p>
    <% if (p.origen) { %><p>Origen: <%= p.origen %></p><% } %>
    <p class="nota">Stock disponible: <%= p.stock %></p>
    <form action="/carrito/agregar" method="post" class="agregar">
      <input type="hidden" name="id" value="<%= p.id %>">
      <label>Cantidad <input type="number" name="cantidad" value="1" min="1" max="10"></label>
      <button>Agregar al carrito</button>
    </form>
  </div>
</article>
<% if (relacionados.length) { %>
<section>
  <h2>También te puede gustar</h2>
  <div class="grilla">
    <% relacionados.forEach(r => { %><%- include('partials/tarjeta', { p: r, volver: '/producto/' + p.slug }) %><% }) %>
  </div>
</section>
<% } %>
<%- include('partials/footer') %>
